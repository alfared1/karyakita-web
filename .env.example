# ==============================================================================
# KONFIGURASI WHATSAPP AUTO-REPLY BERBASIS GEMINI API (KARYAKITA STUDIO)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION (Official @google/genai SDK)
# ------------------------------------------------------------------------------
# Dapatkan API Key secara gratis atau berbayar melalui: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Nama model yang ingin digunakan. Disarankan keluarga Flash agar balasan secepat kilat:
# Pilihan populer: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 2. META WHATSAPP CLOUD API CONFIGURATION (Official Meta Graph API)
# ------------------------------------------------------------------------------
# Dapatkan Permanent System User Token dari Meta Business Manager:
# Meta Business Suite > Business Settings > Users > System Users > Generate New Token
# Berikan permissions: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_ACCESS_TOKEN="EAAxxxxxxYourPermanentSystemUserToken"

# Phone Number ID dari nomor WhatsApp bisnis yang terdaftar di Meta:
# Meta Developers Dashboard > WhatsApp > API Setup > Phone number ID (bukan WhatsApp Business Account ID)
WHATSAPP_PHONE_NUMBER_ID="109876543210987"

# String rahasia acak buatan Anda sendiri untuk verifikasi handshake GET saat mendaftarkan Webhook:
# Contoh: rahasia_karyakita_wa_2026 atau string acak base64
WHATSAPP_VERIFY_TOKEN="karyakita_super_secret_verify_token_2026"

# App Secret dari aplikasi Meta Developers (wajib untuk verifikasi keamanan X-Hub-Signature-256 pada POST):
# Meta Developers Dashboard > App Settings > Basic > App Secret (klik 'Show')
WHATSAPP_APP_SECRET="abcdef1234567890abcdef1234567890"

# Versi Meta Graph API resmi (Default: v22.0)
WHATSAPP_GRAPH_VERSION="v22.0"

# ------------------------------------------------------------------------------
# 3. FITUR & SAKLAR BOT
# ------------------------------------------------------------------------------
# Saklar cepat untuk menyalakan ("true") atau mematikan ("false") balasan otomatis.
# Jika "false", webhook tetap menerima pesan dan mengembalikan 200 OK ke Meta, namun tidak membalas pesan pengguna.
AUTO_REPLY_ENABLED="true"
